# Environment Variables for AutoML Studio

# ===========================================
# BACKEND (FastAPI)
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKENV_MODE=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automl_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=automl_studio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=automl-datasets
MINIO_USE_SSL=false

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=automl-studio

# AutoGluon
AUTOTIME_LIMIT=3600  # 1 hour max for training
AUTOGB_MEMORY_LIMIT=8GB

# ===========================================
# FRONTEND (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MLFLOW_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=AutoML Studio

# ===========================================
# CELERY WORKER
# ===========================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Europe/Moscow

# ===========================================
# PRODUCTION SETTINGS (uncomment for prod)
# ===========================================
# BACKEND_ENV_MODE=production
# MINIO_USE_SSL=true
# JWT_SECRET_KEY=<generate-strong-random-key>
# POSTGRES_PASSWORD=<strong-password>
# MINIO_ACCESS_KEY=<random-access-key>
# MINIO_SECRET_KEY=<random-secret-key>
